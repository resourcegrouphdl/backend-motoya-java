            "const json = pm.response.json();",
            "pm.test('Code INVALID_TRANSITION', () => pm.expect(json.code).to.eql('INVALID_TRANSITION'));",
            "console.log('✅ State machine rechazó correctamente la transición inválida');"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
