    {
      "name": "6. Flujo end-to-end",
      "description": "Ejecutar en orden. Simula el ciclo completo: agente envía → cliente responde → agente ve el chat.",
      "item": [
        {
          "name": "PASO 1 — Agente envía recordatorio de pago",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Mensaje enviado', () => pm.response.to.have.status(201));",
            "const json = pm.response.json();",
            "if (json.wamid) pm.collectionVariables.set('wamid_enviado', json.wamid);",
            "if (json.mensajeId) pm.collectionVariables.set('mensaje_id', json.mensajeId);",
            "console.log('PASO 1 ✅ — Agente envió recordatorio | wamid:', json.wamid);"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/api/v1/cobranzas/whatsapp/enviar", "host": ["{{base_url}}"], "path": ["api","v1","cobranzas","whatsapp","enviar"] },
            "body": { "mode": "raw", "raw": "{\n  \"contratoId\": \"{{contrato_id}}\",\n  \"plantillaId\": \"plt_recordatorio_dia_vencimiento\",\n  \"variablesValores\": {\n    \"nombre_cliente\": \"Cliente Test\",\n    \"numero_cuota\": \"3\",\n    \"monto_cuota\": \"250.00\"\n  },\n  \"telefono\": \"+51{{telefono}}\"\n}" }
          }
        },
        {
          "name": "PASO 2 — Meta confirma entrega (delivered)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status actualizado', () => pm.response.to.have.status(200));",
            "console.log('PASO 2 ✅ — Meta informó entrega | wamid:', pm.collectionVariables.get('wamid_enviado'));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/webhook/meta", "host": ["{{base_url}}"], "path": ["webhook","meta"] },
            "body": { "mode": "raw", "raw": "{\n  \"object\": \"whatsapp_business_account\",\n  \"entry\": [{ \"changes\": [{ \"value\": {\n    \"statuses\": [{\n      \"id\": \"{{wamid_enviado}}\",\n      \"status\": \"delivered\",\n      \"timestamp\": \"{{$timestamp}}\",\n      \"recipient_id\": \"51{{telefono}}\"\n    }]\n  }, \"field\": \"messages\" }] }]\n}" }
          }
        },
        {
          "name": "PASO 3 — Cliente responde con texto",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Responde 200', () => pm.response.to.have.status(200));",
            "console.log('PASO 3 ✅ — Cliente respondió. Dispatcher procesará el mensaje.');"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/webhook/meta", "host": ["{{base_url}}"], "path": ["webhook","meta"] },
            "body": { "mode": "raw", "raw": "{\n  \"object\": \"whatsapp_business_account\",\n  \"entry\": [{ \"changes\": [{ \"value\": {\n    \"messages\": [{\n      \"from\": \"51{{telefono}}\",\n      \"id\": \"wamid.cliente_responde_{{$timestamp}}\",\n      \"timestamp\": \"{{$timestamp}}\",\n      \"type\": \"text\",\n      \"text\": { \"body\": \"Hola, ya hice el depósito al BCP\" }\n    }]\n  }, \"field\": \"messages\" }] }]\n}" }
          }
        },
        {
          "name": "PASO 4 — Agente verifica historial (debe tener INBOUND + OUTBOUND)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Responde 200', () => pm.response.to.have.status(200));",
            "const json = pm.response.json();",
            "const inbound  = json.filter(m => m.direction === 'INBOUND');",
            "const outbound = json.filter(m => m.direction === 'OUTBOUND');",
            "pm.test('Hay mensajes OUTBOUND', () => pm.expect(outbound.length).to.be.greaterThan(0));",
            "console.log('PASO 4 ✅ — Historial | OUTBOUND:', outbound.length, '| INBOUND:', inbound.length);",
            "const ultimoIn = inbound[inbound.length-1];",
            "if (ultimoIn) console.log('Último INBOUND:', ultimoIn.textoRecibido, '| ventana24h expira:', ultimoIn.ventanaServicioExpira);"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/v1/cobranzas/casos/{{contrato_id}}/whatsapp", "host": ["{{base_url}}"], "path": ["api","v1","cobranzas","casos","{{contrato_id}}","whatsapp"] }
          }
        },
        {
          "name": "PASO 5 — Verificar debug log (debe tener payloads guardados)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Responde 200', () => pm.response.to.have.status(200));",
            "const json = pm.response.json();",
            "pm.test('Hay payloads en debug', () => pm.expect(json.length).to.be.greaterThan(0));",
            "console.log('PASO 5 ✅ — Debug log tiene', json.length, 'entradas');",
            "console.log('Flujo end-to-end completado ✅');"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/v1/debug/wa/mensajes", "host": ["{{base_url}}"], "path": ["api","v1","debug","wa","mensajes"] }
          }
        }
      ]
    }
  ]
