            "body": { "mode": "raw", "raw": "{ \"cicloVida\": \"ACTIVO\" }" }
          }
        },
        {
          "name": "5.3 Actualizar nivelEstrategia (sin validación de transición)",
          "event": [{ "listen": "test", "script": { "exec": [
