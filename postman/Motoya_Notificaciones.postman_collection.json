          "name": "Enviar WhatsApp - Recordatorio de cuota",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{firebase_token}}" }
            ],
            "url": { "raw": "{{base_url}}/api/v1/notifications/send", "host": ["{{base_url}}"], "path": ["api", "v1", "notifications", "send"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channel\": \"WHATSAPP\",\n  \"recipient\": \"51987654321\",\n  \"template\": \"RECORDATORIO_CUOTA\",\n  \"variables\": {\n    \"cliente\": \"Juan Pérez\",\n    \"monto\": \"S/ 120.00\",\n    \"fecha\": \"15/03/2026\"\n  },\n  \"contratoId\": \"contrato-abc123\"\n}"
