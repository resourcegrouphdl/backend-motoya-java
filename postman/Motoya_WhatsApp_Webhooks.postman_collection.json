    {
      "name": "4. Conversaciones — Panel Evaluador",
      "description": "Endpoints del panel admin para ver y enviar mensajes manualmente. Requieren token Firebase.",
      "item": [
        {
          "name": "4.1 GET — historial de conversaciones de una solicitud",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Responde 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Es un array', function () {",
                  "    pm.expect(Array.isArray(json)).to.be.true;",
                  "});",
                  "if (json.length > 0) {",
                  "    console.log('Conversaciones encontradas:', json.length);",
                  "    console.log('Primera conversación:', JSON.stringify(json[0], null, 2));",
                  "} else {",
                  "    console.log('No hay conversaciones para esta solicitud (esperado si es nueva)');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_firebase}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/evaluacion/{{solicitud_id}}/conversaciones",
